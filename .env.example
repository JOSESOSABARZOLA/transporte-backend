# ============================================================
# PLANTILLA de variables de entorno del Modulo Transportes.
# Este archivo SI se versiona. El ".env" real NO (contiene secretos).
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# ============================================================

# Puerto de escucha del backend. Evita colision con Instruccion (3002).
PORT=3003

# ---- Base de datos ----
# Contrasena del usuario postgres. La usa docker-compose para crear el contenedor
# y para componer DATABASE_URL. Sin ella, `docker compose up` se detiene.
DB_PASSWORD=

# Cadena de conexion de Prisma.
#   LOCAL  (contenedor publicado): postgresql://postgres:CLAVE@localhost:5434/transportedb?schema=public
#   DOCKER (red interna):          postgresql://postgres:CLAVE@transportedb:5432/transportedb?schema=public
# La aplicacion en ejecucion usa `transporte_app`, un rol SIN privilegios de esquema:
# lee y escribe datos y nada mas. No puede crear ni alterar tablas, ni leer el historial
# de migraciones, ni crear roles. Si una inyeccion SQL prospera, ese es el limite del dano.
# Antes se conectaba como `postgres`, superusuario, y el limite era el servidor entero.
DATABASE_URL=postgresql://transporte_app:CLAVE_DEL_ROL_DE_APLICACION@localhost:5434/transportedb?schema=public&connection_limit=10&pool_timeout=20

# Las MIGRACIONES si necesitan DDL, y van por aqui. Prisma usa `directUrl` para
# `migrate deploy`, `migrate dev` e introspeccion, y `url` para el cliente en ejecucion.
# Son un paso explicito del despliegue, no del arranque: ver DESPLIEGUE.md.
DIRECT_DATABASE_URL=postgresql://postgres:CLAVE@localhost:5434/transportedb?schema=public

# ---- Red ----
# Lista blanca de origenes, separados por coma.
#
# HACEN FALTA LOS DOS. El navegador considera `localhost:5180` y `172.20.136.73:5180`
# origenes DISTINTOS, y como la sesion viaja en una cookie el intercambio lleva
# credenciales: con el origen fuera de la lista, la respuesta se descarta sin aviso.
# Quien entre desde otra maquina lo hara por la IP; quien trabaje en la suya, por
# localhost. Con `credentials: true` no hay comodin posible.
CORS_ORIGINS=http://localhost:5180,http://172.20.136.127:5180

# ---- Limite de peticiones ----
# Cupo por ENDPOINT y por origen, no uno solo por origen: agotar /zonales no impide
# usar el resto de la aplicacion. El punto de salud esta exento.
#
# AVISO: el origen se toma de la direccion de red. Detras de un proxy inverso todas
# las peticiones llegan con la direccion del proxy y comparten cupo; en ese caso hay
# que habilitar la confianza en el proxy antes de subir estos numeros.
LIMITE_VENTANA_MS=60000
LIMITE_MAXIMO=300

# Canje de sesion con Auth central: mas estrecho porque es la superficie de ingreso
# y cada llamada provoca una peticion a un sistema que no es nuestro. Un ingreso
# legitimo lo usa UNA vez por sesion.
LIMITE_MAXIMO_INGRESO=10

# ---- Operacion ----
# CRITICO: las ventanas de carga se evaluan en esta zona horaria. Si queda mal
# configurada, los cierres ocurren a otra hora y nadie lo nota hasta que un
# departamento pierde su ventana.
TZ=America/Guayaquil

# Nivel minimo de registro. Con LOG_LEVEL=debug se activa ademas el registro de
# consultas de Prisma, que debe permanecer desactivado en produccion.
LOG_LEVEL=info

# ============================================================
# ---- Sesion con Auth central ----
# Ver docs/PLAN_INTEGRACION_AUTH.md.
#
# CONFIRMADO Y PROBADO el 2026-08-18 contra el ambiente de desarrollo: el ingreso
# completo funciona de punta a punta. Los nombres son los INSTITUCIONALES, los
# mismos que usan los demas modulos del ecosistema, y por eso estan en ingles
# contra la regla de nombres en espanol: el .env lo lee quien despliega, y tener
# nombres propios seria una trampa el dia de la entrega.
# ============================================================

# Endpoint de canje de Auth central. CONFIRMADO: la API es el 10004. El 10006 es
# el portal visual, que solo necesita el frontend.
AUTH_EXCHANGE_URL=http://172.20.136.127:10004/auth/exchange

# Clave con la que Auth central firma sus tokens (HS256). SECRETO COMPARTIDO:
# quien la tiene puede firmar tokens validos para TODOS los modulos integrados.
# La entrega Auth central. NO se versiona: el valor real va solo en el .env.
# Pendiente con Auth central: pasar a RS256 con clave publica antes de produccion.
AUTH_JWT_SECRET=

# Identificador de este modulo en la tabla `subsystems` de Auth central.
#
# CONFIRMADO el 2026-08-17 contra el servidor de desarrollo: 11 = SIGOC, con 26
# roles. El Cuadro de Colores NO tiene subsistema propio, vive dentro de SIGOC.
# Los otros diez: 1 Seguridades · 2 Timbre · 3 Chat · 4 IVs · 5 Inspeccion ·
# 6 Vehiculos · 7 Actas de Advertencia · 8 Actas-advertencia · 9 Trabajo
# comunitario · 10 Monitoreo.
#
# Se compara con la reclamacion `subsystemId` del token: sin ella, un codigo
# emitido para Timbre o IVs se podria canjear aqui. Vacio o 0 desactiva la
# comprobacion y el arranque lo advierte.
#
# OJO: el Auth DESPLEGADO hoy no envia `subsystemId` en el token —firma solo
# {userId, iat, exp}—, asi que este valor todavia no llega a comprobarse y el
# registro lo advierte en cada canje. Se cumplira solo cuando el Auth desplegado
# se actualice a la version del repositorio project_auth/auth.
AUTH_SUBSYSTEM_ID=11

# Emisor y destinatario del token propio. El destinatario es el CODIGO DEL MODULO en
# Auth central: el contrato lo nombra JWT_AUDIENCE en la guia de backends y
# AUTH_MODULE_CODE en la de frontends, y es el mismo valor.
#
# Sin `aud`, el token de sesion de otro modulo de la AMC firmado con la misma clave
# seria indistinguible del nuestro: las cookies de dominio viajan a todos.
JWT_ISSUER=transporte-backend
JWT_AUDIENCE=TRANSPORTE

# Clave con la que ESTE modulo firma su propio token de sesion. Es distinta de
# AUTH_JWT_SECRET y no se comparte con nadie. NO se versiona.
SESSION_JWT_SECRET=

# Vigencia del token propio, en segundos. Por omision 28800 = 8 horas.
SESSION_EXPIRES_IN=28800

# Cookie de sesion. `segura` exige HTTPS: en desarrollo sobre HTTP debe quedar en
# false, o el navegador descarta la cookie sin decir nada y no se abre sesion.
AUTH_COOKIE_NAME=cuadro_colores_sesion
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Clave del rol de ejecucion `transporte_app`. DISTINTA de DB_PASSWORD, que es la de
# `postgres` y solo la usan el contenedor de la base y las migraciones.
APP_DB_PASSWORD=

# Base de la API de Auth central, de la que cuelga `/users`. Alimenta el directorio de
# personal de P-07 (2026-08-21). Es una variable APARTE de AUTH_EXCHANGE_URL aunque hoy
# apunten al mismo servidor: aquella nombra un endpoint concreto, y recortarle el camino
# para adivinar la base se rompe el dia que Auth mueva una de las dos.
# Vacia significa SIN DIRECTORIO: P-07 sigue administrando el maestro como siempre.
AUTH_API_URL=http://172.20.136.127:10004
