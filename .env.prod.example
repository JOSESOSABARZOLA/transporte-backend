# ============================================================================
# PLANTILLA del .env del SERVIDOR · 172.20.136.127
#
# Este archivo SI se versiona. El ".env.prod" real NO: trae las claves de produccion
# y se entrega por canal seguro junto al .tar de las imagenes, como hace Instruccion.
#
#   cp .env.prod.example .env.prod      # y completar los cuatro secretos
#
# Se usa SOLO con el compose de produccion:
#   docker compose -f docker-compose.prod.yml up -d
# ============================================================================

PORT=3003
TZ=America/Guayaquil
LOG_LEVEL=info

# NODE_ENV endurece el arranque: con `production`, validar-entorno.ts EXIGE CORS_ORIGINS y
# AUTH_COOKIE_SECURE=true, y helmet emite HSTS. Se deja COMENTADO mientras se sirva por
# HTTP: activarlo sin TLS detendria el arranque (la cookie Secure exige HTTPS). El dia que
# haya HTTPS por delante, se descomenta ESTA linea Y se pone AUTH_COOKIE_SECURE=true, las
# dos juntas.
# NODE_ENV=production

# ---- Base de datos ----------------------------------------------------------
# Dos claves DISTINTAS, y la separacion es el motivo de que existan las dos:
#
#   postgres        -> el contenedor de la base y las MIGRACIONES. Puede todo.
#   transporte_app  -> la aplicacion en ejecucion. Lee y escribe datos y nada mas.
#
# El rol de aplicacion no existe hasta que se crea. Se ejecuta UNA vez por base, despues
# de la primera migracion: prisma/roles/crear-rol-aplicacion.sql
DB_PASSWORD=
APP_DB_PASSWORD=

# NO hay DATABASE_URL ni DIRECT_DATABASE_URL aqui: las compone el compose con los nombres
# de la red interna de Docker. Escribirlas en este archivo las dejaria apuntando a
# localhost, que dentro del contenedor no es la base.

# ---- Red --------------------------------------------------------------------
# LOS ORIGENES REALES DESDE LOS QUE SE ABRE LA APLICACION, separados por coma.
#
# ES LA VARIABLE QUE MAS SILENCIOSAMENTE ROMPE EL DESPLIEGUE. Con el origen fuera de esta
# lista y `credentials: true`, el navegador descarta la respuesta SIN ERROR: la pantalla
# queda en blanco y no hay nada en el registro del servidor que lo explique.
#
# En el servidor la aplicacion se abre por IP, no por localhost, asi que el que cuenta es
# el primero. El de localhost se conserva para quien entre desde el propio servidor.
CORS_ORIGINS=http://172.20.136.127:5180,http://localhost:5180

LIMITE_VENTANA_MS=60000
LIMITE_MAXIMO=300
LIMITE_MAXIMO_INGRESO=10

# ---- Sesion con Auth central ------------------------------------------------
# Auth central vive en ESTE MISMO servidor: la API en el 10004, el portal en el 10006.
AUTH_EXCHANGE_URL=http://172.20.136.127:10004/auth/exchange
AUTH_API_URL=http://172.20.136.127:10004

# SECRETO COMPARTIDO. Quien lo tiene puede firmar tokens validos para TODOS los modulos
# integrados del ecosistema. Lo entrega el equipo de Auth central.
AUTH_JWT_SECRET=

# SECRETO PROPIO, y DISTINTO del anterior. Con el firma este modulo su propia cookie.
# Usar el mismo valor en los dos permitiria a cualquier modulo integrado emitir sesiones
# validas aqui. Si queda vacia, toda peticion responde 401 y el registro lo advierte.
SESSION_JWT_SECRET=

# 11 = SIGOC. El Cuadro de Colores no tiene subsistema propio, vive dentro de SIGOC.
AUTH_SUBSYSTEM_ID=11

JWT_ISSUER=transporte-backend
JWT_AUDIENCE=TRANSPORTE
SESSION_EXPIRES_IN=28800

AUTH_COOKIE_NAME=cuadro_colores_sesion
# false MIENTRAS SE SIRVA POR HTTP. `true` exige TLS: con HTTPS por delante hay que
# ponerlo en true, y sin HTTPS el navegador descartaria la cookie sin decir nada. Va de la
# mano con NODE_ENV=production (arriba): validar-entorno.ts detiene el arranque si se
# declara produccion y esta queda en false. Se cambian las dos a la vez, con TLS delante.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# ---- Firma digital de la orden de servicio (.p12) --------------------------
# OPCIONAL. Sin estas tres variables, el memorando de la orden se entrega SIN firmar y el
# registro deja un aviso (modo inerte). Con las tres, el backend firma el memorando llamando
# al servicio externo de firma de la AMC (POST multipart: pdf + certificado + clave + pagina).
# Si el servicio esta configurado y falla, la emision responde 502 con mensaje al funcionario.
# Ver `firma-digital.client.ts`.
#
#   FIRMA_URL        URL COMPLETA del endpoint de firma (mismo contrato que resolucion):
#                    p. ej. http://<host-firma>:<puerto>/api/firmas/sign-pdf/upload
#   FIRMA_P12_PATH   Ruta del certificado .p12 DENTRO del contenedor (montarlo como volumen
#                    de solo lectura; NO va en la imagen ni en el repositorio).
#   FIRMA_P12_CLAVE  Clave del certificado .p12. SECRETO.
#   FIRMA_TOKEN      (opcional) Bearer que exija el servicio de firma.
#   FIRMA_PAGINA     (opcional) Pagina donde va la firma; por omision la ULTIMA (bloque de firma).
FIRMA_URL=
FIRMA_P12_PATH=
FIRMA_P12_CLAVE=
FIRMA_TOKEN=
FIRMA_PAGINA=

# ============================================================================
# LO QUE NO VA AQUI: las variables VITE_.
#
# Se hornean en la imagen del frontend al CONSTRUIRLA, no se leen al arrancar. Ponerlas
# en este archivo no cambiaria nada y haria creer que si. Si hay que cambiar la direccion
# del portal de Auth, se reconstruye la imagen:
#
#   VITE_AUTH_PORTAL_URL=http://<host>:10006/login docker compose build transporte-front
# ============================================================================
